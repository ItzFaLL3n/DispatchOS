# Dispatch OS — Phase 1 environment variables.
# Copy to .env.local for local dev; set the same keys in Vercel for deploy.
# Never commit real values. .env* is gitignored.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The password you type to log into the app.
APP_PASSWORD=

# Long random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# Your own timezone, for the client-local clock. Defaults to Asia/Kolkata.
OPERATOR_TZ=Asia/Kolkata

# console.anthropic.com → API Keys. Used by Creator's Live AI mode
# (/api/generate-post). Template mode works without this set.
ANTHROPIC_API_KEY=

# Shared secret between this app and the CRM-assistant worker (spec 0003,
# worker/). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Same value goes on both sides — this app's env and the worker's env.
WORKER_SHARED_SECRET=

# The deployed assistant worker's URL (worker/, spec 0003). Local dev:
# http://localhost:8787.
ASSISTANT_WORKER_URL=
