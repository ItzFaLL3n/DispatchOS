# Dispatch OS assistant worker — copy to .env for local dev, set the same
# keys on whichever host you deploy to (Render/Railway/Fly).

# Same value as web/.env.local's WORKER_SHARED_SECRET.
WORKER_SHARED_SECRET=

# The deployed Next.js app's URL (e.g. https://dispatch-os-delta.vercel.app).
# Where this worker's read tools call back to.
VERCEL_APP_URL=

# From `claude setup-token`, run locally with your own Claude subscription
# login. Valid 1 year. See worker/README.md.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional, defaults to 8787.
PORT=
